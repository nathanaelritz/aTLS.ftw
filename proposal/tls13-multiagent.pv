(* Run as follows with subfolder <traces>:
proverif205 -lib tls-lib-simple.pvl -html traces tls13-multiagent.pv 2>&1 | tee log.txt
*)

(* 
Summary: 
  Server's service identity: ID_S associated with pubEK
  Key associated with VM identity: pubEK (Note: initially unknown; after successful attestation)
  General organization for modeling: (ID_S,pubAK,pubEK)

Details:
  Each guest instance is identified by ID_S.
  The model allows multiple tenants (guest VM) per server machine. 
  So multiple pubEK per server machine. 

We want to model that some server machines may be compromised while others remain secure.
The compromise of a server machine is modelled by leaking privAK or privEK.
*)

(* Generation of agents and keys *)
(* All parameters for Server side *)
(*    agent_keys(ID_S    ,privAK ,pubAK ,dev_statusRef *)
table agent_keys(identity,privkey,pubkey,bitstring).
table ca_store(privkey).

let gen_agents_data () =
  (* Imagine the following as generating the data of a single server machine (single agent)
  and the replication then produces multiple server machines (multi-agent) *)
  
  (* Server Side - Host Platform Scope (Physical Machine / Hardware RoT) *)
  new privAK: privkey;  (* attestation key for signing evidence *)
  let pubAK = pk(privAK) in
  out(io, pubAK); (* public keys should be available to attacker *)
  
  !( (* Tenant CVM Scope (Multiple Guest VMs per Host) *)
  (* This replication allows to model multiple VMs on the same physical machine
     which is typical in cloud scenarios. *)
    
     new ID_S: identity;   (* PKI service identity of the tenant, e.g., FQDN *)
     out(io,ID_S);  (* Identity is public *)

     new dev_statusRef: bitstring;  (* represents ref. cVM launch measurements *)
     out(io, dev_statusRef);
       
     (* Record in the table *)
     insert agent_keys(ID_S,privAK,pubAK,dev_statusRef)
  )
.

(* Mark the event when the keys of a specific machine are leaked
i.e., not all server machines are compromised at the same time *)
let LEK(privEK:privkey) =
  event LeakedEK(pk(privEK));  (* mark the leakage of EK *)
  out(io, privEK)
.

let LAK =
  get agent_keys(ID_S,privAK,pubAK,_) in
  event LeakedAK(pubAK);  (* mark the leakage of AK *)  
  out(io, privAK)
.

let LCA =
  get ca_store(privCA) in
  event CompromisedCA(pk(privCA));  (* mark the compromise of the CA *)  
  out(io, privCA)
.

(* x509 Certificates, e.g., RFC8555 ACME, SPIFFE/SPIRE etc. *)
let gen_cert_csr (ID_S:identity,privEK:privkey) =
  get ca_store(privCA) in
  let pubEK = pk(privEK) in
  
  let CA_sig = sign(privCA,(ID_S,pubEK)) in   
  let x509_cert = X509(ID_S,pubEK,CA_sig) in  (* Structured X.509 PKI cert *) 
  out(io, x509_cert)
.

let run_Client(pubCA:pubkey) = 
  (* Intuitively, the following models a single client (single agent) 
  and the replication takes care of multiple clients (multi agent) *)
  new ID_C:identity;  (* long-term identity of the client *)

  (* Choose a server machine (potentially a compromised one) to communicate with. *)
  (! (* this allows the same client to talk to different servers *)
     (* ID_S (=hostname/FQDN/SAN) is known to the client, e.g., the desired website it wants to connect. *)
     get agent_keys(ID_S,_,_,dev_statusRef) in
     get agent_keys(_,_,pubAK,_) in

     (* Define RP appraisal policy to ensure ID_S selected matches expected TEE measurements - per Section 8.5 of RFC9334 *)
     let authz_authn = (ID_S, dev_statusRef) in

     (* The following replication models multiple sessions of client with these parameters *)
     !Client(ID_C,ID_S,pubAK,pubCA,authz_authn)
  )
.

let run_Server(pubCA:pubkey) = 
  (* Intuitively, this models a single server and the replication takes care of multiple servers *)
  (* Allow several combinations, but for each private key, choose the corresponding public key *)
  get agent_keys(ID_S,_,_,_) in 
  get agent_keys(_,privAK,pubAK,_) in
  
  (* Generate fresh ephemeral keys for every new cVM server instance *)
  new privEK: privkey;  (* VM key for TLS *)
  let pubEK = pk(privEK) in
  out(io, pubEK);

  !(LEK(privEK)) (* Enable ephemeral key leak oracle *)

| !(gen_cert_csr(ID_S,privEK) (* e.g., RFC8555 ACME, SPIFFE/SPIRE, etc. *))
| !(
    (* Retrieve the CA-signed cert from previous CSR over adversary controlled io *)
    in(io, (x509_cert:cert_data)); 

    let X509(=ID_S, =pubEK, ca_sig:bitstring) = x509_cert in (* check x509 data format *)
    if verify(pubCA, (ID_S, pubEK), ca_sig) = true then (* check CA signature *)

    (* The following replication models multiple sessions of server with these parameters *)
    !(Server(ID_S,privEK,privAK,x509_cert))
  )
.

(* set traceDisplay = long. Display full trace *)
(* set verboseClauses = short. *)
(* main system *)
(* process 0 *)
process
  (* Web PKI CA *)
  new privCA:privkey;
  let pubCA = pk(privCA) in 
  out(io,pubCA);
  insert ca_store(privCA);

  !(gen_agents_data)

  | !(run_Client(pubCA)) | !(run_Server(pubCA))
  (* | !(LCA) *)
  | !(LAK)
  (* | !(LEK) process moved inline with run_Server *)
  | !(SendBadElement)
